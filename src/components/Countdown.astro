---
// Countdown.astro — cuenta regresiva en placas azul noche con filete dorado
interface Props {
	targetDate: string;
}

const { targetDate } = Astro.props;
const units = [
	{ id: 'days', label: 'Días' },
	{ id: 'hours', label: 'Horas' },
	{ id: 'minutes', label: 'Min' },
	{ id: 'seconds', label: 'Seg' },
];
---

<div class="countdown" id="countdown" data-target={targetDate}>
	<p class="countdown-title">Faltan</p>
	<div class="countdown-grid">
		{units.map((u) => (
			<div class="cd-box">
				<span class="cd-val" data-unit={u.id}>00</span>
				<span class="cd-label">{u.label}</span>
			</div>
		))}
	</div>
	<p class="countdown-done" hidden>¡Hoy es el gran día!</p>
</div>

<style>
	.countdown {
		text-align: center;
		margin: 6px auto 0;
	}

	.countdown-title {
		font-family: var(--font-caps);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 5px;
		text-transform: uppercase;
		color: var(--metal-dark);
		margin-bottom: 12px;
	}

	.countdown-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
		max-width: 330px;
		margin: 0 auto;
	}

	.cd-box {
		position: relative;
		padding: 14px 4px 11px;
		border-radius: 14px;
		color: var(--ivory);
		background: linear-gradient(165deg, var(--char-700), var(--char-900));
		box-shadow: 0 10px 20px rgba(28, 28, 32, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.12);
		overflow: hidden;
	}

	.cd-box::after {
		content: '';
		position: absolute;
		inset: 3px;
		border-radius: 11px;
		border: 1px solid rgba(161, 156, 150, 0.55);
		pointer-events: none;
	}

	.cd-val {
		display: block;
		font-family: var(--font-caps);
		font-weight: 600;
		font-size: 26px;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		background: var(--metal-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.cd-val.tick {
		animation: tick 0.5s var(--ease-out);
	}

	.cd-label {
		display: block;
		margin-top: 3px;
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--char-200);
	}

	.countdown-done {
		margin-top: 12px;
		font-family: var(--font-script);
		font-size: 36px;
		color: var(--rose-dark);
	}

	@keyframes tick {
		0% { transform: translateY(-6px); opacity: 0.3; }
		100% { transform: none; opacity: 1; }
	}
</style>

<script>
	const el = document.getElementById('countdown');
	if (el) {
		const target = new Date(el.dataset.target ?? '').getTime();
		const vals = Object.fromEntries(
			Array.from(el.querySelectorAll<HTMLElement>('.cd-val')).map((v) => [v.dataset.unit, v])
		);
		const done = el.querySelector<HTMLElement>('.countdown-done');
		const pad = (n: number) => String(n).padStart(2, '0');

		const set = (unit: string, value: string) => {
			const node = vals[unit];
			if (!node || node.textContent === value) return;
			node.textContent = value;
			node.classList.remove('tick');
			void node.offsetWidth;
			node.classList.add('tick');
		};

		let timer = 0;
		const update = () => {
			const diff = target - Date.now();
			if (diff <= 0) {
				['days', 'hours', 'minutes', 'seconds'].forEach((u) => set(u, '00'));
				if (done) done.hidden = false;
				window.clearInterval(timer);
				return;
			}
			set('days', pad(Math.floor(diff / 86400000)));
			set('hours', pad(Math.floor((diff / 3600000) % 24)));
			set('minutes', pad(Math.floor((diff / 60000) % 60)));
			set('seconds', pad(Math.floor((diff / 1000) % 60)));
		};

		update();
		timer = window.setInterval(update, 1000);
	}
</script>

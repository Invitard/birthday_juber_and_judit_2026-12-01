---
// Calendar.astro — diciembre 2026 con el martes 1 marcado con un corazón dorado
const year = 2026;
const month = 11; // diciembre (0-indexado)
const highlight = 1;

const firstWeekday = (new Date(Date.UTC(year, month, 1)).getUTCDay() + 6) % 7; // lunes = 0
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const cells: (number | null)[] = [
	...Array.from({ length: firstWeekday }, () => null),
	...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const weekdays = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
---

<div class="calendar" aria-label="Calendario de diciembre de 2026, martes 1 marcado">
	<div class="cal-head">
		<span class="cal-month">Diciembre</span>
		<span class="cal-year">2026</span>
	</div>
	<div class="cal-grid">
		{weekdays.map((d) => <span class="cal-wd">{d}</span>)}
		{cells.map((day) =>
			day === null ? (
				<span class="cal-empty" />
			) : day === highlight ? (
				<span class="cal-day is-party" aria-label="Martes 1: ¡la celebración!">
					<svg class="cal-heart" viewBox="0 0 24 24" aria-hidden="true">
						<defs>
							<linearGradient id="calHeart" x1="0" y1="0" x2="1" y2="1">
								<stop offset="0" stop-color="#233d6e" />
								<stop offset="1" stop-color="#c4979a" />
							</linearGradient>
						</defs>
						<path d="M12 21s-7.5-4.6-9.6-9.4C.9 8 3 4 6.8 4c2.2 0 3.7 1.2 5.2 3 1.5-1.8 3-3 5.2-3C21 4 23.1 8 21.6 11.6 19.5 16.4 12 21 12 21z" fill="url(#calHeart)" stroke="#ffffff" stroke-width=".8" />
					</svg>
					<span class="cal-num">{day}</span>
				</span>
			) : (
				<span class="cal-day">{day}</span>
			)
		)}
	</div>
</div>

<style>
	.calendar {
		max-width: 320px;
		margin: 0 auto;
		padding: 18px 16px 16px;
		background: #fff;
		border-radius: 18px;
		border: 1px solid var(--sand);
		box-shadow: 0 0 0 5px var(--ivory), 0 0 0 6px rgba(161, 156, 150, 0.45), 0 14px 30px rgba(28, 28, 32, 0.12);
	}

	.cal-head {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 10px;
		margin-bottom: 12px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--pearl);
	}

	.cal-month {
		font-family: var(--font-script);
		font-size: 36px;
		line-height: 1;
		color: var(--char-800);
	}

	.cal-year {
		font-family: var(--font-caps);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 2px;
		color: var(--metal-dark);
	}

	.cal-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 4px;
		text-align: center;
	}

	.cal-wd {
		font-family: var(--font-caps);
		font-size: 10px;
		font-weight: 600;
		color: var(--metal-dark);
		padding-bottom: 4px;
	}

	.cal-day {
		position: relative;
		display: grid;
		place-items: center;
		height: 32px;
		font-family: var(--font-serif);
		font-size: 15px;
		font-weight: 500;
		color: var(--ink-soft);
	}

	.cal-day.is-party {
		color: #fff;
		font-weight: 700;
	}

	.cal-heart {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 40px;
		height: 40px;
		margin: -20px 0 0 -20px;
		filter: drop-shadow(0 3px 5px rgba(28, 28, 32, 0.3));
		animation: heart-beat 2.4s ease-in-out infinite;
	}

	.cal-num {
		position: relative;
		margin-top: -2px;
	}

	@keyframes heart-beat {
		0%, 100% { transform: scale(1); }
		12% { transform: scale(1.14); }
		24% { transform: scale(1); }
		36% { transform: scale(1.08); }
		48% { transform: scale(1); }
	}
</style>

---
// MusicToggle.astro — "Celebration" (Kool & The Gang) suena al abrir el sobre
// Si la canción no carga, el botón no aparece
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const song = `${base}/mp3/celebration.mp3`; // Kool & The Gang - Celebration
---

<audio id="story-music" src={song} preload="auto"></audio>

<button class="music-btn" id="music-btn" type="button" aria-label="Reproducir música" aria-pressed="false" hidden>
	<span class="music-notes" aria-hidden="true"><i>♪</i><i>♫</i><i>♪</i></span>
	<svg class="ic-play" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z" /></svg>
	<svg class="ic-mute" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 18V5l10-2v11" /><circle cx="6" cy="18" r="3" /><path d="M3 3l18 18" /></svg>
</button>

<style>
	.music-btn {
		position: fixed;
		right: 16px;
		bottom: calc(18px + env(safe-area-inset-bottom));
		z-index: 90;
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		border-radius: 50%;
		color: var(--metal-light);
		background: linear-gradient(160deg, var(--char-700), var(--char-950));
		border: 1px solid var(--metal);
		box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4);
		animation: music-in 0.6s var(--ease-spring) both;
		transition: transform 0.25s var(--ease-spring);
	}

	.music-btn[hidden] {
		display: none;
	}

	.music-btn:active {
		transform: scale(0.9);
	}

	.ic-mute,
	.music-btn.is-playing .ic-play + .ic-mute {
		display: none;
	}

	.music-btn:not(.is-playing) .ic-play {
		display: none;
	}

	.music-btn:not(.is-playing) .ic-mute {
		display: block;
	}

	.music-btn.is-playing {
		animation: music-in 0.6s var(--ease-spring) both, music-spin-glow 2.4s ease-in-out infinite;
	}

	.music-notes {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.music-notes i {
		position: absolute;
		left: 50%;
		top: 0;
		font-style: normal;
		font-size: 14px;
		color: var(--metal);
		opacity: 0;
	}

	.music-btn.is-playing .music-notes i {
		animation: note-rise 2.4s ease-out infinite;
	}

	.music-btn.is-playing .music-notes i:nth-child(2) { animation-delay: 0.8s; color: var(--rose); }
	.music-btn.is-playing .music-notes i:nth-child(3) { animation-delay: 1.6s; color: var(--char-200); }

	@keyframes note-rise {
		0% { transform: translate(-50%, 0) scale(0.6); opacity: 0; }
		20% { opacity: 1; }
		100% { transform: translate(calc(-50% - 18px), -42px) scale(1.1) rotate(-20deg); opacity: 0; }
	}

	@keyframes music-in {
		from { transform: scale(0); opacity: 0; }
		to { transform: none; opacity: 1; }
	}

	@keyframes music-spin-glow {
		0%, 100% { box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4), 0 0 0 0 rgba(228, 226, 223, 0.5); }
		50% { box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4), 0 0 0 9px rgba(228, 226, 223, 0); }
	}
</style>

<script>
	const audio = document.getElementById('story-music') as HTMLAudioElement | null;
	const btn = document.getElementById('music-btn');

	if (audio && btn) {
		// Segundo en el que empieza la canción (también al repetirse)
		const START_AT = 0;
		const seekStart = () => {
			if (audio.currentTime < START_AT) audio.currentTime = START_AT;
		};
		if (audio.readyState >= 1) seekStart();
		else audio.addEventListener('loadedmetadata', seekStart, { once: true });
		audio.addEventListener('ended', () => {
			audio.currentTime = START_AT;
			audio.play().catch(() => {});
		});

		const sync = () => {
			const playing = !audio.paused;
			btn.classList.toggle('is-playing', playing);
			btn.setAttribute('aria-pressed', String(playing));
			btn.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
		};

		const play = () => {
			audio.volume = 0.55;
			seekStart();
			audio.play().catch(() => {}).finally(sync);
		};

		audio.addEventListener('play', sync);
		audio.addEventListener('pause', sync);

		btn.addEventListener('click', () => (audio.paused ? play() : audio.pause()));

		// Si la canción no carga, no mostramos el botón
		let songOk = true;
		audio.addEventListener('error', () => { songOk = false; btn.hidden = true; });
		const showButton = () => { if (songOk) btn.hidden = false; };
		if (document.getElementById('story-cover')) {
			// Se inicia dentro del clic para que el navegador permita el audio
			document.addEventListener('story:opening', play, { once: true });
			document.addEventListener('story:open', showButton, { once: true });
		} else {
			showButton();
		}
	}
</script>

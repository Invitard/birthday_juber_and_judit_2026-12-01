---
// DiscoBall.astro — bola de disco 3D dibujada en canvas que gira sobre su propio eje vertical.
// Cada espejo se calcula en 3D (latitud/longitud), se ilumina según su orientación y destella
// cuando refleja la luz. Incluye cordón, brillo ambiental y reflejos de luz que barren la sección.
interface Props {
	size?: number;
	/** segundos por vuelta completa */
	period?: number;
	class?: string;
}

const { size = 170, period = 9, class: className = '' } = Astro.props;

// Reflejos de luz (deterministas)
const specks = Array.from({ length: 34 }, (_, i) => {
	const angle = (i * 137.5) % 360;
	const dist = 30 + ((i * 53) % 70);
	return {
		x: 50 + Math.cos((angle * Math.PI) / 180) * dist * 0.62,
		y: 50 + Math.sin((angle * Math.PI) / 180) * dist * 0.5,
		s: 3 + ((i * 7) % 6),
		tone: ['w', 'w', 'b', 'w', 'r'][i % 5],
		d: ((i * 0.37) % 3).toFixed(2),
	};
});
---

<div class={`disco ${className}`} style={`--disco-size:${size}px`} aria-hidden="true">
	<div class="disco-lights">
		{specks.map((p) => (
			<span class={`speck speck-${p.tone}`} style={`left:${p.x}%;top:${p.y}%;width:${p.s}px;height:${p.s}px;animation-delay:${p.d}s`}></span>
		))}
	</div>
	<span class="disco-cord"></span>
	<span class="disco-cap"></span>
	<span class="disco-glow"></span>
	<canvas class="disco-canvas" data-disco data-period={period} width={size} height={size}></canvas>
</div>

<style>
	.disco {
		position: relative;
		width: var(--disco-size);
		height: calc(var(--disco-size) + 70px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
	}

	/* Reflejos que giran lentamente alrededor, como en una pista de baile */
	.disco-lights {
		position: absolute;
		left: 50%;
		top: calc(70px + var(--disco-size) / 2);
		width: 380px;
		height: 380px;
		margin: -190px 0 0 -190px;
		pointer-events: none;
		animation: lights-spin 22s linear infinite;
	}

	.speck {
		position: absolute;
		border-radius: 2px;
		rotate: 45deg;
		background: #fff;
		box-shadow: 0 0 8px 2px rgba(255, 255, 255, 0.55);
		opacity: 0;
		animation: speck-flash 3s ease-in-out infinite;
	}

	.speck-b {
		background: #dfe8f8;
		box-shadow: 0 0 8px 2px rgba(120, 150, 210, 0.6);
	}

	.speck-r {
		background: #f6e1e1;
		box-shadow: 0 0 8px 2px rgba(214, 160, 163, 0.6);
	}

	.disco-cord {
		position: absolute;
		top: 0;
		left: 50%;
		width: 1.5px;
		height: 66px;
		margin-left: -0.75px;
		background: linear-gradient(180deg, transparent, #b9bcc2 30%, #8d9096);
	}

	.disco-cap {
		position: absolute;
		top: 60px;
		left: 50%;
		width: 16px;
		height: 12px;
		margin-left: -8px;
		border-radius: 3px 3px 6px 6px;
		background: linear-gradient(90deg, #6d7076, #e9ebee 45%, #8a8d93);
		z-index: 2;
	}

	.disco-glow {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: calc(var(--disco-size) * 1.7);
		height: calc(var(--disco-size) * 1.7);
		margin: 0 0 calc(var(--disco-size) * -0.35) calc(var(--disco-size) * -0.85);
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.16) 0%, rgba(200, 210, 230, 0.07) 35%, transparent 65%);
		animation: glow-breathe 4s ease-in-out infinite;
		pointer-events: none;
	}

	.disco-canvas {
		position: relative;
		width: var(--disco-size);
		height: var(--disco-size);
		filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.5));
		animation: disco-sway 6s ease-in-out infinite;
		transform-origin: 50% -60px;
	}

	@keyframes lights-spin {
		to { rotate: 360deg; }
	}

	@keyframes speck-flash {
		0%, 100% { opacity: 0; transform: scale(0.4); }
		40%, 60% { opacity: 0.9; transform: scale(1); }
	}

	@keyframes glow-breathe {
		0%, 100% { opacity: 0.7; }
		50% { opacity: 1; }
	}

	@keyframes disco-sway {
		0%, 100% { transform: rotate(-1.5deg); }
		50% { transform: rotate(1.5deg); }
	}

	@media (prefers-reduced-motion: reduce) {
		.disco-lights,
		.disco-canvas {
			animation: none;
		}
	}
</style>

<script>
	type Tile = { lat0: number; lat1: number; lon0: number; lon1: number; tint: [number, number, number]; jitter: number; phase: number };

	const TAU = Math.PI * 2;
	const TILT = -0.32; // inclinación hacia el espectador para ver un poco la parte superior
	const L = normalize([-0.45, 0.55, 0.7]); // luz principal
	const H = normalize([L[0], L[1], L[2] + 1]); // vector medio luz/vista

	function normalize(v: number[]): [number, number, number] {
		const m = Math.hypot(v[0], v[1], v[2]);
		return [v[0] / m, v[1] / m, v[2] / m];
	}

	function buildTiles(): Tile[] {
		const tiles: Tile[] = [];
		const rows = 18;
		let seed = 7;
		const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
		for (let r = 0; r < rows; r++) {
			const lat0 = -Math.PI / 2 + (r / rows) * Math.PI;
			const lat1 = -Math.PI / 2 + ((r + 1) / rows) * Math.PI;
			const mid = (lat0 + lat1) / 2;
			const cols = Math.max(6, Math.round(36 * Math.cos(mid)));
			for (let c = 0; c < cols; c++) {
				const t = rnd();
				// Mayoría plata; algunos espejos con reflejo azul (él) o rosado (ella)
				const tint: [number, number, number] = t < 0.1 ? [0.82, 0.88, 1] : t < 0.18 ? [1, 0.86, 0.87] : [1, 1, 1];
				tiles.push({ lat0, lat1, lon0: (c / cols) * TAU, lon1: ((c + 1) / cols) * TAU, tint, jitter: 0.75 + rnd() * 0.5, phase: rnd() * TAU });
			}
		}
		return tiles;
	}

	// Punto de la esfera unidad, rotado sobre el eje vertical y luego inclinado
	function point(lat: number, lon: number): [number, number, number] {
		const x = Math.cos(lat) * Math.sin(lon);
		const y = Math.sin(lat);
		const z = Math.cos(lat) * Math.cos(lon);
		const ct = Math.cos(TILT), st = Math.sin(TILT);
		return [x, y * ct - z * st, y * st + z * ct];
	}

	document.querySelectorAll<HTMLCanvasElement>('canvas[data-disco]').forEach((canvas) => {
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		const cssSize = canvas.width;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		canvas.width = canvas.height = Math.round(cssSize * dpr);
		ctx.scale(dpr, dpr);

		const R = cssSize / 2 - 2;
		const cx = cssSize / 2;
		const cy = cssSize / 2;
		const tiles = buildTiles();
		const period = (Number(canvas.dataset.period) || 9) * 1000;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const gap = 0.09;

		const draw = (time: number) => {
			const spin = ((time % period) / period) * TAU;
			ctx.clearRect(0, 0, cssSize, cssSize);

			// Base oscura (juntas entre espejos)
			const base = ctx.createRadialGradient(cx - R * 0.3, cy - R * 0.35, R * 0.1, cx, cy, R);
			base.addColorStop(0, '#5b5d63');
			base.addColorStop(1, '#16171a');
			ctx.fillStyle = base;
			ctx.beginPath();
			ctx.arc(cx, cy, R, 0, TAU);
			ctx.fill();

			const glints: [number, number, number][] = [];

			for (const t of tiles) {
				const dLat = (t.lat1 - t.lat0) * gap;
				const dLon = (t.lon1 - t.lon0) * gap;
				const a = t.lat0 + dLat, b = t.lat1 - dLat;
				const c0 = t.lon0 + dLon + spin, c1 = t.lon1 - dLon + spin;
				const n = point((a + b) / 2, (c0 + c1) / 2);
				if (n[2] <= 0.02) continue; // cara oculta

				const p1 = point(a, c0), p2 = point(a, c1), p3 = point(b, c1), p4 = point(b, c0);

				const diffuse = Math.max(0, n[0] * L[0] + n[1] * L[1] + n[2] * L[2]);
				const specDot = Math.max(0, n[0] * H[0] + n[1] * H[1] + n[2] * H[2]);
				const spec = Math.pow(specDot, 28);
				const shimmer = 0.5 + 0.5 * Math.sin(time / 380 + t.phase);
				let lum = (0.16 + 0.55 * diffuse * t.jitter + 0.12 * shimmer * n[2]) + spec * 1.3;
				lum = Math.min(1, lum);
				const v = Math.round(40 + lum * 215);
				ctx.fillStyle = `rgb(${Math.min(255, v * t.tint[0])},${Math.min(255, v * t.tint[1])},${Math.min(255, v * t.tint[2])})`;
				ctx.beginPath();
				ctx.moveTo(cx + p1[0] * R, cy - p1[1] * R);
				ctx.lineTo(cx + p2[0] * R, cy - p2[1] * R);
				ctx.lineTo(cx + p3[0] * R, cy - p3[1] * R);
				ctx.lineTo(cx + p4[0] * R, cy - p4[1] * R);
				ctx.closePath();
				ctx.fill();

				if (spec > 0.55 && shimmer > 0.6) glints.push([cx + n[0] * R, cy - n[1] * R, spec]);
			}

			// Sombra de volumen en el borde y brillo especular general
			const rim = ctx.createRadialGradient(cx - R * 0.25, cy - R * 0.3, R * 0.2, cx, cy, R);
			rim.addColorStop(0, 'rgba(255,255,255,0.10)');
			rim.addColorStop(0.7, 'rgba(0,0,0,0)');
			rim.addColorStop(1, 'rgba(0,0,0,0.55)');
			ctx.fillStyle = rim;
			ctx.beginPath();
			ctx.arc(cx, cy, R, 0, TAU);
			ctx.fill();

			// Destellos en estrella sobre los espejos que reflejan la luz
			for (const [x, y, s] of glints.slice(0, 4)) {
				const len = 6 + s * 10;
				const g = ctx.createRadialGradient(x, y, 0, x, y, len);
				g.addColorStop(0, 'rgba(255,255,255,0.95)');
				g.addColorStop(1, 'rgba(255,255,255,0)');
				ctx.fillStyle = g;
				ctx.beginPath();
				ctx.arc(x, y, len * 0.55, 0, TAU);
				ctx.fill();
				ctx.strokeStyle = 'rgba(255,255,255,0.85)';
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.moveTo(x - len, y);
				ctx.lineTo(x + len, y);
				ctx.moveTo(x, y - len);
				ctx.lineTo(x, y + len);
				ctx.stroke();
			}
		};

		if (reduced) {
			draw(1200);
			return;
		}

		let raf = 0;
		let running = false;
		const loop = (t: number) => {
			draw(t);
			raf = requestAnimationFrame(loop);
		};
		new IntersectionObserver((entries) => {
			const visible = entries[0].isIntersecting;
			if (visible && !running) {
				running = true;
				raf = requestAnimationFrame(loop);
			} else if (!visible && running) {
				running = false;
				cancelAnimationFrame(raf);
			}
		}).observe(canvas);
		draw(0);
	});
</script>

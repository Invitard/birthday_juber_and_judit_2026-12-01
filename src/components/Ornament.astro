---
// Ornament.astro — adornos SVG de la gala: destello, corona, balón, separador y monograma
interface Props {
	variant: 'sparkle' | 'crown' | 'ball' | 'divider' | 'monogram' | 'heart';
	size?: number;
	class?: string;
	style?: string;
	/** Para el separador: icono central */
	center?: 'crown' | 'ball' | 'heart';
}

const { variant, size = 24, class: className = '', style = '', center = 'crown' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

{variant === 'sparkle' && (
	<svg class={`orn orn-sparkle ${className}`} style={style} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
		<path d="M12 0c.9 6.4 5.1 10.8 12 12-6.9 1.2-11.1 5.6-12 12-.9-6.4-5.1-10.8-12-12C6.9 10.8 11.1 6.4 12 0z" fill="currentColor" />
	</svg>
)}

{variant === 'crown' && (
	<svg class={`orn orn-crown ${className}`} style={style} width={size} height={size * 0.72} viewBox="0 0 50 36" aria-hidden="true">
		<defs>
			<linearGradient id={`cg-${uid}`} x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#9c7d45" />
				<stop offset=".45" stop-color="#e8d6a8" />
				<stop offset=".55" stop-color="#f5ead0" />
				<stop offset="1" stop-color="#a88a52" />
			</linearGradient>
		</defs>
		<path d="M5 28 2 9l11 9 12-15 12 15 11-9-3 19z" fill={`url(#cg-${uid})`} stroke="#8f7440" stroke-width=".8" stroke-linejoin="round" />
		<rect x="5" y="28.5" width="40" height="5" rx="2" fill={`url(#cg-${uid})`} stroke="#8f7440" stroke-width=".8" />
		<circle cx="2" cy="8" r="2" fill="#f5ead0" stroke="#8f7440" stroke-width=".6" />
		<circle cx="25" cy="2.6" r="2.2" fill="#f5ead0" stroke="#8f7440" stroke-width=".6" />
		<circle cx="48" cy="8" r="2" fill="#f5ead0" stroke="#8f7440" stroke-width=".6" />
		<circle cx="25" cy="20" r="2.6" fill="#b4878a" />
		<circle cx="14" cy="22" r="1.6" fill="#22396a" />
		<circle cx="36" cy="22" r="1.6" fill="#22396a" />
	</svg>
)}

{variant === 'ball' && (
	<svg class={`orn orn-ball ${className}`} style={style} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="10.4" fill="#faf7f1" stroke="#22396a" stroke-width="1.2" />
		<path d="M12 7.6l3.6 2.6-1.4 4.2H9.8L8.4 10.2z" fill="#22396a" />
		<path d="M12 7.6V2.2M15.6 10.2l5-1.8M14.2 14.4l3 4.4M9.8 14.4l-3 4.4M8.4 10.2l-5-1.8" stroke="#22396a" stroke-width="1.1" stroke-linecap="round" />
		<path d="M10 2.4 12 3.6l2-1.2M20 6.6l.2 2.4 1.6 1.6M18.6 19.4l-2.2-.4-1.6 1.8M5.4 19.4l2.2-.4 1.6 1.8M4 6.6l-.2 2.4-1.6 1.6" stroke="#22396a" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}

{variant === 'heart' && (
	<svg class={`orn orn-heart ${className}`} style={style} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
		<path d="M12 21s-7.5-4.6-9.6-9.4C.9 8 3 4 6.8 4c2.2 0 3.7 1.2 5.2 3 1.5-1.8 3-3 5.2-3C21 4 23.1 8 21.6 11.6 19.5 16.4 12 21 12 21z" fill="currentColor" />
	</svg>
)}

{variant === 'monogram' && (
	<svg class={`orn orn-monogram ${className}`} style={style} width={size} height={size} viewBox="0 0 120 120" aria-hidden="true">
		<defs>
			<linearGradient id={`mg-${uid}`} x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#8d9096" />
				<stop offset=".45" stop-color="#dfe1e4" />
				<stop offset=".55" stop-color="#ffffff" />
				<stop offset="1" stop-color="#8a8d93" />
			</linearGradient>
		</defs>
		<circle cx="60" cy="60" r="56" fill="none" stroke={`url(#mg-${uid})`} stroke-width="1.4" />
		<circle cx="60" cy="60" r="51" fill="none" stroke={`url(#mg-${uid})`} stroke-width=".6" stroke-dasharray="1.5 3" />
		<text x="60" y="73" text-anchor="middle" font-family="Pinyon Script, cursive" font-size="40" fill={`url(#mg-${uid})`}>J&amp;J</text>
	</svg>
)}

{variant === 'divider' && (
	<div class={`orn-divider ${className}`} style={style} aria-hidden="true">
		<span class="orn-line"></span>
		<svg class="orn-diamond" width="8" height="8" viewBox="0 0 10 10"><path d="M5 0 10 5 5 10 0 5z" fill="#a19c96" /></svg>
		{center === 'crown' && (
			<svg width="30" height="22" viewBox="0 0 50 36">
				<path d="M5 28 2 9l11 9 12-15 12 15 11-9-3 19z" fill="none" stroke="#a19c96" stroke-width="2" stroke-linejoin="round" />
				<path d="M5 31.5h40" stroke="#a19c96" stroke-width="2.4" stroke-linecap="round" />
			</svg>
		)}
		{center === 'ball' && (
			<svg width="22" height="22" viewBox="0 0 24 24">
				<circle cx="12" cy="12" r="10.4" fill="none" stroke="#a19c96" stroke-width="1.3" />
				<path d="M12 7.6l3.6 2.6-1.4 4.2H9.8L8.4 10.2z" fill="#a19c96" />
				<path d="M12 7.6V2.2M15.6 10.2l5-1.8M14.2 14.4l3 4.4M9.8 14.4l-3 4.4M8.4 10.2l-5-1.8" stroke="#a19c96" stroke-width="1.1" stroke-linecap="round" />
			</svg>
		)}
		{center === 'heart' && (
			<svg width="20" height="20" viewBox="0 0 24 24">
				<path d="M12 21s-7.5-4.6-9.6-9.4C.9 8 3 4 6.8 4c2.2 0 3.7 1.2 5.2 3 1.5-1.8 3-3 5.2-3C21 4 23.1 8 21.6 11.6 19.5 16.4 12 21 12 21z" fill="none" stroke="#a19c96" stroke-width="1.6" />
			</svg>
		)}
		<svg class="orn-diamond" width="8" height="8" viewBox="0 0 10 10"><path d="M5 0 10 5 5 10 0 5z" fill="#a19c96" /></svg>
		<span class="orn-line"></span>
	</div>
)}

<style>
	.orn {
		display: inline-block;
		flex-shrink: 0;
	}

	.orn-divider {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		width: 100%;
		max-width: 260px;
		margin: 0 auto;
	}

	.orn-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--metal), transparent);
	}

	.orn-diamond {
		animation: diamond-glint 3s ease-in-out infinite;
	}

	.orn-diamond:last-of-type {
		animation-delay: 1.5s;
	}

	@keyframes diamond-glint {
		0%, 100% { opacity: 0.45; transform: scale(0.8); }
		50% { opacity: 1; transform: scale(1.1); }
	}
</style>

---
// NumberBalloons.astro — globos plateados con forma de número (p. ej. 6 + 5 = "65"),
// con cintas rizadas en los colores de cada cumpleañero y flotación desfasada.
interface Props {
	value: string;
	tone: 'him' | 'her';
	label?: string;
	size?: number;
	class?: string;
}

const { value, tone, label, size = 78, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ratio: Record<string, number> = { '0': 494 / 420, '5': 531 / 420, '6': 513 / 413 };
const digits = value.split('');
const ribbons = tone === 'him' ? ['#233d6e', '#ffffff'] : ['#c4979a', '#c2a56b'];
---

<div class={`balloons balloons-${tone} ${className}`} style={`--b-size:${size}px`} role="img" aria-label={`Globos con el número ${value}${label ? ` para ${label}` : ''}`}>
	<div class="b-row">
		{digits.map((d, i) => (
			<span class="b-digit" style={`--i:${i};--h:${Math.round(size * (ratio[d] ?? 1.2))}px`}>
				<img src={`${base}/img/elements/globo-${d}.webp`} alt="" width={size} height={Math.round(size * (ratio[d] ?? 1.2))} loading="eager" />
			</span>
		))}
	</div>
	<svg class="b-strings" viewBox="0 0 100 70" preserveAspectRatio="none" aria-hidden="true">
		<path d="M32 0 C 26 14, 40 22, 34 34 S 44 52, 48 70" stroke={ribbons[0]} />
		<path d="M68 0 C 74 12, 60 24, 66 36 S 56 54, 52 70" stroke={ribbons[1]} />
		<path d="M50 70 C 46 62, 44 60, 40 62" stroke={ribbons[0]} />
		<path d="M50 70 C 54 62, 58 60, 61 63" stroke={ribbons[1]} />
	</svg>
	{label && <span class="b-label">{label}</span>}
</div>

<style>
	.balloons {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
	}

	.b-row {
		display: flex;
		align-items: flex-end;
		position: relative;
		z-index: 1;
	}

	.b-digit {
		display: block;
		width: var(--b-size);
		margin-left: calc(var(--b-size) * -0.16 * var(--i));
		transform-origin: 50% 100%;
		animation: b-float 4.6s ease-in-out infinite;
		animation-delay: calc(var(--i) * -1.7s);
		filter: drop-shadow(0 12px 14px rgba(0, 0, 0, 0.28)) drop-shadow(0 2px 2px rgba(0, 0, 0, 0.15));
	}

	.b-digit:nth-child(2) {
		margin-top: calc(var(--b-size) * 0.18);
		animation-duration: 5.4s;
	}

	.b-digit img {
		width: 100%;
		height: auto;
	}

	.b-strings {
		width: calc(var(--b-size) * 1.2);
		height: calc(var(--b-size) * 0.75);
		margin-top: -4px;
		overflow: visible;
		animation: strings-sway 4.6s ease-in-out infinite;
		transform-origin: 50% 0;
	}

	.b-strings path {
		fill: none;
		stroke-width: 1.4;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	.balloons-him .b-strings path:nth-child(2) {
		filter: drop-shadow(0 0 0.6px rgba(0, 0, 0, 0.45));
	}

	.b-label {
		margin-top: 2px;
		font-family: var(--font-caps);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 3px;
		text-transform: uppercase;
	}

	.balloons-him .b-label { color: var(--him-100); }
	.balloons-her .b-label { color: #ecd3d4; }

	@keyframes b-float {
		0%, 100% { transform: translateY(0) rotate(-3deg); }
		50% { transform: translateY(-9px) rotate(3deg); }
	}

	@keyframes strings-sway {
		0%, 100% { transform: skewX(-4deg); }
		50% { transform: skewX(4deg); }
	}
</style>

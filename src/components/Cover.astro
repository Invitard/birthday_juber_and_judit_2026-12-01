---
// Cover.astro — portada: el libro de cuentos que se abre al tocarlo
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stars = Array.from({ length: 28 }, (_, i) => ({
	x: (i * 37 + 11) % 100,
	y: (i * 53 + 7) % 100,
	s: 6 + ((i * 7) % 10),
	d: ((i * 0.37) % 3).toFixed(2),
}));
---

<div class="cover" id="story-cover" role="dialog" aria-modal="true" aria-label="Portada del cuento de Emma Esmeralda">
	<div class="cover-stars" aria-hidden="true">
		{stars.map((st) => (
			<svg class="cover-star" style={`left:${st.x}%;top:${st.y}%;width:${st.s}px;height:${st.s}px;animation-delay:${st.d}s`} viewBox="0 0 24 24">
				<path d="M12 0c.9 6.4 5.1 10.8 12 12-6.9 1.2-11.1 5.6-12 12-.9-6.4-5.1-10.8-12-12C6.9 10.8 11.1 6.4 12 0z" fill="currentColor" />
			</svg>
		))}
	</div>

	<div class="cover-content">
		<p class="cover-kicker">Un cuento de hadas</p>
		<h1 class="cover-title">Emma Esmeralda</h1>
		<p class="cover-sub">y su reino encantado</p>

		<button class="book" id="open-book" aria-label="Abrir el cuento">
			<span class="book-glow" aria-hidden="true"></span>
			<span class="book-page" aria-hidden="true">
				<span class="book-page-text">Había<br />una vez…</span>
			</span>
			<img class="book-cover" src={`${base}/img/elements/libro.webp`} alt="Libro de cuentos con la silueta dorada de una princesita" width="800" height="1120" />
		</button>

		<p class="cover-hint">
			<span class="hint-dot" aria-hidden="true"></span>
			Toca el libro para comenzar el cuento
		</p>
	</div>
</div>

<style>
	.cover {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: center;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 50% 55%, rgba(42, 92, 194, 0.55) 0%, transparent 60%),
			radial-gradient(ellipse at 50% 0%, #1d3f8f 0%, #0b1f4d 55%, #071638 100%);
		transition: opacity 0.9s ease, visibility 0s linear 0.9s;
	}

	.cover.is-open {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.cover-stars {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.cover-star {
		position: absolute;
		color: #f6d77a;
		animation: star-twinkle 2.8s ease-in-out infinite;
	}

	@keyframes star-twinkle {
		0%, 100% { opacity: 0.15; transform: scale(0.6) rotate(0deg); }
		50% { opacity: 1; transform: scale(1) rotate(30deg); }
	}

	.cover-content {
		position: relative;
		text-align: center;
		padding: 24px 16px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cover-kicker {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 4px;
		text-transform: uppercase;
		color: var(--blue-200);
		animation: fade-down 1s var(--ease-out) both;
	}

	.cover-title {
		font-family: var(--font-script);
		font-weight: 400;
		font-size: clamp(46px, 13vw, 64px);
		line-height: 1.1;
		background: var(--gold-gradient);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 2px 8px rgba(246, 215, 122, 0.35));
		animation: fade-down 1s var(--ease-out) 0.15s both, shimmer 4s linear infinite;
	}

	.cover-sub {
		font-family: var(--font-story);
		font-style: italic;
		font-size: 18px;
		color: var(--blue-100);
		margin-bottom: 18px;
		animation: fade-down 1s var(--ease-out) 0.3s both;
	}

	.book {
		position: relative;
		width: min(62vw, 250px);
		aspect-ratio: 800 / 1120;
		perspective: 1400px;
		animation: book-float 4s ease-in-out infinite, book-in 1.2s var(--ease-spring) 0.4s both;
		transition: transform 0.9s var(--ease-out);
	}

	.book-glow {
		position: absolute;
		inset: -18%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(246, 215, 122, 0.55) 0%, rgba(107, 155, 230, 0.25) 40%, transparent 70%);
		animation: glow-pulse 2.6s ease-in-out infinite;
		pointer-events: none;
	}

	.book-page {
		position: absolute;
		left: 10%;
		right: 8%;
		top: 8%;
		bottom: 4%;
		border-radius: 4px 10px 10px 4px;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.12), transparent 12%),
			#fffdf6;
		display: grid;
		place-items: center;
		box-shadow: inset 0 0 30px rgba(168, 120, 28, 0.25);
	}

	.book-page-text {
		font-family: var(--font-script);
		font-size: clamp(30px, 9vw, 40px);
		line-height: 1.1;
		color: var(--blue-700);
		opacity: 0;
		transition: opacity 0.6s ease 0.5s;
	}

	.book-cover {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transform-origin: 9% 50%;
		backface-visibility: hidden;
		transition: transform 1.3s cubic-bezier(0.6, 0, 0.2, 1);
		filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45));
	}

	.book:hover .book-cover {
		transform: rotateY(-12deg);
	}

	.cover.is-opening .book {
		animation: none;
		transform: scale(1.12);
	}

	.cover.is-opening .book-cover {
		transform: rotateY(-165deg);
	}

	.cover.is-opening .book-page-text {
		opacity: 1;
	}

	.cover-hint {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: 26px;
		padding: 10px 18px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(246, 215, 122, 0.4);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.5px;
		color: #fff;
		animation: fade-up 1s var(--ease-out) 1s both;
	}

	.hint-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--red-400);
		box-shadow: 0 0 0 0 rgba(232, 80, 92, 0.7);
		animation: hint-ping 1.6s ease-out infinite;
	}

	@keyframes book-float {
		0%, 100% { transform: translateY(0) rotate(-1.5deg); }
		50% { transform: translateY(-10px) rotate(1.5deg); }
	}

	@keyframes book-in {
		from { opacity: 0; transform: translateY(40px) scale(0.8); }
		to { opacity: 1; transform: none; }
	}

	@keyframes glow-pulse {
		0%, 100% { opacity: 0.6; transform: scale(0.95); }
		50% { opacity: 1; transform: scale(1.05); }
	}

	@keyframes hint-ping {
		to { box-shadow: 0 0 0 12px rgba(232, 80, 92, 0); }
	}

	@keyframes fade-down {
		from { opacity: 0; transform: translateY(-14px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes fade-up {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes shimmer {
		from { background-position: 200% 0; }
		to { background-position: -200% 0; }
	}
</style>

<script>
	const cover = document.getElementById('story-cover');
	const book = document.getElementById('open-book');

	if (cover && book) {
		document.body.classList.add('is-locked');

		const open = () => {
			if (cover.classList.contains('is-opening')) return;
			cover.classList.add('is-opening');
			// Dentro del gesto del usuario para que el navegador permita la música
			document.dispatchEvent(new CustomEvent('story:opening'));
			// El libro queda abierto 5 segundos y luego se desvanece
			window.setTimeout(() => cover.classList.add('is-open'), 5000);
			window.setTimeout(() => {
				document.body.classList.remove('is-locked');
				document.dispatchEvent(new CustomEvent('story:open'));
			}, 5900);
		};

		book.addEventListener('click', open);
	}
</script>
